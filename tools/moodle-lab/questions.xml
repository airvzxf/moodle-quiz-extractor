<quiz>
  <question type="multichoice">
    <name><text>so</text></name>
    <questiontext format="html"><text><![CDATA[<p>¿Cuál de los siguientes es un sistema operativo?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Linux es un sistema operativo; los demás son protocolos o lenguajes.</p>]]></text></generalfeedback>
    <defaultgrade>10</defaultgrade>
    <single>true</single>
    <shuffleanswers>false</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <answer fraction="100" format="html"><text>Linux</text><feedback format="html"><text>Correcto.</text></feedback></answer>
    <answer fraction="0" format="html"><text>HTTP</text><feedback format="html"><text>Es un protocolo.</text></feedback></answer>
    <answer fraction="0" format="html"><text>HTML</text><feedback format="html"><text>Es un lenguaje de marcado.</text></feedback></answer>
    <answer fraction="0" format="html"><text>TCP</text><feedback format="html"><text>Es un protocolo.</text></feedback></answer>
  </question>

